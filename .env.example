# ==========================================================
# Variables de entorno — copiar a .env y rellenar con valores
#   cp .env.example .env
# NUNCA subir el archivo .env real al repositorio.
# ==========================================================

# --- PostgreSQL ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Backend ---
# Cadena de conexión que usa Prisma. En docker-compose el host es "db".
# Formato: postgresql://USER:PASSWORD@HOST:5432/DB?schema=public
DATABASE_URL=
PORT=3000

# --- Frontend ---
# URL base del backend que consume el frontend (build de Vite).
VITE_API_URL=
